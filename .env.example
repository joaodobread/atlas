# Copie para .env e ajuste. Para dev, suba as dependências com:
#   docker compose -f containers/compose.yaml --profile deps up -d
PORT=3001

# --- Postgres (container local, RDS, Aurora, Cloud SQL…) ---
DATABASE_URL=postgres://commgraph:commgraph@127.0.0.1:5432/commgraph
# disable | require | verify-full (RDS: verify-full + bundle de CA da AWS)
DATABASE_SSL=disable
# DATABASE_SSL_CA=/caminho/global-bundle.pem
# DATABASE_POOL_MAX=10

# --- Storage S3 (RustFS/MinIO local, AWS S3, Cloudflare R2…) ---
# Sem S3_ENDPOINT = AWS S3 (usa IAM role/credenciais do ambiente se as chaves faltarem).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=commgraph
S3_SECRET_KEY=commgraph-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PRIVATE=comm-graph-private
S3_BUCKET_PUBLIC=comm-graph-public
# URL pública (CDN) do bucket público; vazio = endpoint/bucket
# S3_PUBLIC_BASE_URL=https://arquivos.exemplo.com
# Cria buckets e política pública se faltarem (desligue em contas AWS gerenciadas)
S3_AUTO_CREATE_BUCKETS=true

# Embeddings locais (baixados na 1ª indexação, ~130MB; também guardados no bucket privado)
EMBEDDING_MODEL=Xenova/multilingual-e5-small
MODELS_DIR=data/models

# LLM (também configurável pela interface): none | anthropic | openai-compatible
LLM_PROVIDER=none
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MENTIONS=auto

# --- Segurança ---
# Obrigatório em produção (32+ caracteres). Sem ele (dev), uma chave é gerada em data/secret.key.
# APP_SECRET=
# Atrás de HTTPS:
# COOKIE_SECURE=true
# SESSION_DAYS=30
# Proxy reverso confiável (loopback, IPs/CIDRs ou número de saltos)
# TRUST_PROXY=loopback
