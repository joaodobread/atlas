{
  "name": "comm-graph",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaodobread/atlas.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "start": "node --enable-source-maps dist/server/main.js",
    "seed": "tsx scripts/seed.ts",
    "import": "tsx scripts/import.ts",
    "migrate:sqlite": "tsx scripts/migrate-sqlite.ts",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outfile=dist/server/main.js",
    "start:dev": "tsx server/main.ts",
    "lint": "oxlint --type-aware",
    "format": "oxfmt server shared src scripts test vite.config.ts vitest.config.ts .github containers integrations *.md",
    "format:check": "oxfmt --check server shared src scripts test vite.config.ts vitest.config.ts .github containers integrations *.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@huggingface/transformers": "^3.0.2",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "d3-force-3d": "^3.0.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "lucide-react": "^0.460.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^13.21.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
